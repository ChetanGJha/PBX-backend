PROJECT_NAME="Production Multi-Tenant PBX"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

SECRET_KEY="super-secret-jwt-signing-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="pbx_user"
POSTGRES_PASSWORD="pbx_password_secure"
POSTGRES_DB="pbx_db"
DATABASE_URL="postgresql+asyncpg://pbx_user:pbx_password_secure@localhost:5432/pbx_db"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

FREESWITCH_ESL_HOST="localhost"
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD="ClueCon"
FREESWITCH_DOMAIN="pbx.local"

STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="C:/PROJECTS/PBX/recordings"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""
GCS_BUCKET_NAME=""

<configuration name="xml_curl.conf" description="Dynamic XML Configuration Provider via HTTP">
  <bindings>
    <binding name="directory">
      <param name="gateway-url" value="http://api:8000/freeswitch/xml" method="POST"/>
      <param name="timeout" value="10"/>
      <param name="enable-post-load" value="true"/>
      <param name="bind-params" value="both"/>
    </binding>
    
    <binding name="dialplan">
      <param name="gateway-url" value="http://api:8000/freeswitch/xml" method="POST"/>
      <param name="timeout" value="10"/>
      <param name="enable-post-load" value="true"/>
      <param name="bind-params" value="both"/>
    </binding>
    
    <binding name="configuration">
      <param name="gateway-url" value="http://api:8000/freeswitch/xml" method="POST"/>
      <param name="timeout" value="10"/>
      <param name="enable-post-load" value="true"/>
      <param name="bind-params" value="both"/>
    </binding>
  </bindings>
</configuration>

<profile name="external-crossconnect">
  <gateways>
    <X-PRE-PROCESS cmd="include" data="external-crossconnect/*.xml"/>
  </gateways>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-port" value="$${crossconnect_sip_port}"/>
    <param name="dialplan" value="XML"/>
    <param name="context" value="public"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <!-- Cross Connect Direct IP (No NAT) -->
    <param name="ext-rtp-ip" value="$${crossconnect_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${crossconnect_sip_ip}"/>
    <param name="user-agent-string" value="MultiTenantPBX-External-FixedLine"/>
    <!-- Codec Preferences -->
    <param name="inbound-codec-prefs" value="PCMU,PCMA,G722,OPUS"/>
    <param name="outbound-codec-prefs" value="PCMU,PCMA,G722,OPUS"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="auth-calls" value="false"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="NDLB-force-rport" value="true"/>
    <param name="pass-rfc2833" value="true"/>
  </settings>
</profile>

<profile name="internal">
  <aliases>
    <alias name="pbx.terrixai.com"/>
    <alias name="pbx.aikyamlabs.local"/>
    <alias name="127.0.0.1"/>
    <alias name="8.234.117.15"/>
    <alias name="10.0.0.128"/>
  </aliases>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-port" value="5060"/>
    <param name="dialplan" value="XML"/>
    <param name="context" value="public"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>
    <param name="user-agent-string" value="MultiTenantPBX-FreeSWITCH"/>

    <!-- Codec Preferences -->
    <param name="inbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="OPUS,PCMU,PCMA"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="inbound-codec-negotiation" value="generous"/>

    <!-- Carrier Whitelist & Extension Authentication -->
    <param name="apply-inbound-acl" value="carrier_gateways"/>
    <param name="auth-calls" value="true"/>
    <param name="auth-registrations" value="true"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <param name="suppress-cng" value="true"/>
    <param name="challenge-realm" value="auto_to"/>

    <!-- Advanced NAT and Contact Traversal for Softphones & Mobile Clients -->
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="local-network-acl" value="localnet.auto"/>
    <param name="NDLB-force-rport" value="true"/>
    <param name="NDLB-broken-auth-hash" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>
    <param name="NDLB-sendrecv-in-nat" value="true"/>
    <param name="aggressive-nat-detection" value="true"/>
    <param name="nat-options-ping" value="true"/>

    <!-- WebRTC WSS Configuration -->
    <param name="ws-binding" value=":5066"/>
    <param name="wss-binding" value=":7443"/>
    <param name="tls" value="true"/>
    <param name="tls-cert-dir" value="/etc/freeswitch/tls"/>

    <!-- RTP Media Settings & Session Timers -->
    <param name="insecure-configured" value="true"/>
    <param name="enable-timer" value="true"/>
    <param name="session-timeout" value="120"/>
    <param name="minimum-session-expires" value="90"/>
    <param name="rtp-timeout-sec" value="30"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
  </settings>
</profile>

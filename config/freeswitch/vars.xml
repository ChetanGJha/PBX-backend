<include>
  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="domain_name=$${domain}"/>
  <X-PRE-PROCESS cmd="set" data="hold_music=local_stream://moh"/>
  <X-PRE-PROCESS cmd="set" data="use_profile=default"/>
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=OPUS,G722,PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=PCMU,PCMA,G722"/>
  <X-PRE-PROCESS cmd="set" data="bind_server_ip=0.0.0.0"/>
  <X-PRE-PROCESS cmd="set" data="internal_auth_calls=true"/>
  <X-PRE-PROCESS cmd="set" data="internal_sip_port=5060"/>
  <X-PRE-PROCESS cmd="set" data="external_sip_port=5080"/>
  <X-PRE-PROCESS cmd="set" data="webrtc_sip_port=7443"/>
  <X-PRE-PROCESS cmd="set" data="default_password=1234"/>
  <X-PRE-PROCESS cmd="set" data="us-ring=%(2000,4000,440.0,480.0)"/>
  <X-PRE-PROCESS cmd="set" data="ringback=$${us-ring}"/>
  <!-- GCP VM NAT to Public IP for ITS SBC & remote clients -->
  <X-PRE-PROCESS cmd="set" data="external_sip_ip=8.234.117.15"/>
  <X-PRE-PROCESS cmd="set" data="external_rtp_ip=8.234.117.15"/>
  <X-PRE-PROCESS cmd="set" data="gcp_vm_private_ip=10.0.0.128"/>
  <!-- Cross Connect IP for Fixed Line series SBC (Private direct connect, NO NAT) -->
  <X-PRE-PROCESS cmd="set" data="crossconnect_sip_ip=10.50.185.245"/>
  <X-PRE-PROCESS cmd="set" data="crossconnect_rtp_ip=10.50.185.245"/>
  <X-PRE-PROCESS cmd="set" data="crossconnect_sip_port=5090"/>
</include>

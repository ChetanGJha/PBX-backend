# Environment Configuration for Multi-Tenant PBX

# Application Settings
PROJECT_NAME="Production Multi-Tenant PBX"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security / JWT Settings
SECRET_KEY="super-secret-jwt-signing-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="pbx_user"
POSTGRES_PASSWORD="pbx_password_secure"
POSTGRES_DB="pbx_db"
DATABASE_URL="postgresql+asyncpg://pbx_user:pbx_password_secure@postgres:5432/pbx_db"

# Redis Cache Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"

# FreeSWITCH Settings
FREESWITCH_ESL_HOST="freeswitch"
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD="ClueCon"
FREESWITCH_DOMAIN="pbx.local"

# Storage Configuration (local, s3, gcs)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="/var/lib/freeswitch/recordings"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""
GCS_BUCKET_NAME=""
